<?xml version="1.0"?>
<sdf version="1.9">
  <world name="field">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>10</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <model name="ARCC_S2_3v3_Battlefield">
      <!-- ARCC Season 2 3v3 Battlefield, generated by arcc_s2_3v3/cad/arcc_3v3_field.py
           already in the field frame: REP-105, (0, 0) at the centre on the floor,
           x along the 12 m toward blue's base. Collision is static structure only;
           tape, Bumpy Road, the placeholder zig-zag pole and objectives are not. -->
      <static>true</static>
      <link name="field">
        <collision name="field_collision">
          <geometry><mesh><uri>model://sim/world/arcc_s2_3v3/meshes/collision.stl</uri></mesh></geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor">
          <geometry><mesh><uri>model://sim/world/arcc_s2_3v3/meshes/visual_floor.stl</uri></mesh></geometry>
          <material><diffuse>0.7 0.7 0.7 1</diffuse><ambient>0.7 0.7 0.7 1</ambient></material>
        </visual>
        <visual name="wood">
          <geometry><mesh><uri>model://sim/world/arcc_s2_3v3/meshes/visual_wood.stl</uri></mesh></geometry>
          <material><diffuse>0.78 0.62 0.43 1</diffuse><ambient>0.78 0.62 0.43 1</ambient></material>
        </visual>
        <visual name="dark">
          <geometry><mesh><uri>model://sim/world/arcc_s2_3v3/meshes/visual_dark.stl</uri></mesh></geometry>
          <material><diffuse>0.25 0.25 0.27 1</diffuse><ambient>0.25 0.25 0.27 1</ambient></material>
        </visual>
        <visual name="platform">
          <geometry><mesh><uri>model://sim/world/arcc_s2_3v3/meshes/visual_platform.stl</uri></mesh></geometry>
          <material><diffuse>0.62 0.62 0.62 1</diffuse><ambient>0.62 0.62 0.62 1</ambient></material>
        </visual>
        <visual name="bumpy_road">
          <geometry><mesh><uri>model://sim/world/arcc_s2_3v3/meshes/visual_bumpy_road.stl</uri></mesh></geometry>
          <material><diffuse>0.12 0.12 0.12 1</diffuse><ambient>0.12 0.12 0.12 1</ambient></material>
        </visual>
        <visual name="pole">
          <geometry><mesh><uri>model://sim/world/arcc_s2_3v3/meshes/visual_pole.stl</uri></mesh></geometry>
          <material><diffuse>0.6 0.6 0.62 1</diffuse><ambient>0.6 0.6 0.62 1</ambient></material>
        </visual>
        <visual name="tape_red">
          <geometry><mesh><uri>model://sim/world/arcc_s2_3v3/meshes/visual_tape_red.stl</uri></mesh></geometry>
          <material><diffuse>0.85 0.1 0.1 1</diffuse><ambient>0.85 0.1 0.1 1</ambient></material>
        </visual>
        <visual name="tape_blue">
          <geometry><mesh><uri>model://sim/world/arcc_s2_3v3/meshes/visual_tape_blue.stl</uri></mesh></geometry>
          <material><diffuse>0.1 0.25 0.85 1</diffuse><ambient>0.1 0.25 0.85 1</ambient></material>
        </visual>
        <visual name="tape_green">
          <geometry><mesh><uri>model://sim/world/arcc_s2_3v3/meshes/visual_tape_green.stl</uri></mesh></geometry>
          <material><diffuse>0.1 0.65 0.2 1</diffuse><ambient>0.1 0.65 0.2 1</ambient></material>
        </visual>
      </link>
    </model>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>
    <wind/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-9 -9 9 0 0.6 0.785</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
