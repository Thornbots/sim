<?xml version="1.0"?>
<!-- Default field: launch and sim's field geometry read <sdf> from here, so
     changing the default field is this one edit. Every field world is named
     "field" (sim/field.py, include/sim/field.hpp). -->
<model>
  <name>ARCC_S2_3v3_Battlefield</name>
  <version>1.0</version>
  <sdf version="1.9">ARCC_S2_3v3.sdf</sdf>
  <description>ARCC Season 2 (2026-27) 3v3 Battlefield</description>
</model>
