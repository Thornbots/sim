<?xml version="1.0"?>
<!-- The new sentry for gz: sentry_v2/sentry_v2.urdf (generated, from the
     mechanical team's CAD) plus the sensors, plugins and contact settings
     the export doesn't carry. Gravity and collision are on; VelocityControl
     sets the chassis's velocity from /cmd_vel and zeroes its yaw rate (about
     1 deg still leaks in during hard corners).
     see README.md for design rationale -->
<robot name="sentry" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="camera" default="false"/>
  <!-- The gz model name, so each copy's plugin topics are its own. -->
  <xacro:arg name="name" default="sentry"/>
  <!-- An opponent carries no sensors, and spins its chassis on
       chassis_spin under a heading-fixed spin_base, since VelocityControl
       takes a body-frame twist (a spinning chassis would swirl its path
       between commands). -->
  <xacro:arg name="opponent" default="false"/>
  <xacro:property name="name" value="$(arg name)"/>
  <xacro:include filename="$(find sim)/urdf/sentry_v2/sentry_v2.urdf"/>

  <!-- Colour (gz only; the generated URDF has no materials, so rviz draws it
       grey), and hidden from the lidar: visibility_mask 0x01 below renders
       none of the robot, and lidar_self_filter models the blind sector
       instead, as on hardware. -->
  <xacro:macro name="body_visual" params="link rgb">
    <gazebo reference="${link}">
      <visual>
        <material>
          <ambient>${rgb} 1</ambient>
          <diffuse>${rgb} 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
        <visibility_flags>0xFFFFFFFE</visibility_flags>
      </visual>
    </gazebo>
  </xacro:macro>
  <xacro:body_visual link="root" rgb="0.18 0.18 0.2"/>
  <xacro:body_visual link="head" rgb="0.75 0.08 0.08"/>
  <xacro:body_visual link="head_pitch" rgb="0.9 0.35 0.1"/>
  <xacro:body_visual link="armor_0" rgb="0.85 0.85 0.85"/>
  <xacro:body_visual link="armor_1" rgb="0.85 0.85 0.85"/>
  <xacro:body_visual link="armor_2" rgb="0.85 0.85 0.85"/>
  <xacro:body_visual link="armor_3" rgb="0.85 0.85 0.85"/>

  <!-- Corner i: a sprung carrier (spring rate and travel are placeholders in
       sentry_v2.yaml) and a sphere wheel with no friction, so wheels ride
       along under the velocity-driven chassis rather than fighting it. -->
  <xacro:macro name="corner" params="i">
    <xacro:body_visual link="carrier_${i}" rgb="0.6 0.62 0.65"/>
    <xacro:body_visual link="wheel_${i}" rgb="0.08 0.08 0.08"/>
    <gazebo reference="suspension_${i}">
      <springReference>0.0</springReference>
      <springStiffness>2200.0</springStiffness>
    </gazebo>
    <gazebo reference="wheel_${i}">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:corner i="0"/>
  <xacro:corner i="1"/>
  <xacro:corner i="2"/>
  <xacro:corner i="3"/>

  <!-- Where the shot leaves: on the pitch axis, between the flywheels.
       thornbots_pkg's URDF carries the same frame. -->
  <link name="muzzle"/>
  <joint name="muzzlelink" type="fixed">
    <parent link="head_pitch"/>
    <child link="muzzle"/>
    <origin xyz="0 0.1128 0" rpy="0 0 0"/>
  </joint>

  <!-- Same sensor as sentry.urdf.xacro's: an RPLIDAR A2M8 in its typical
       mode, 10 Hz and 800 beams over -pi..pi (rf2o assumes a zero-centred
       scan), 0.15-12 m, 0.01 m noise. -->
  <xacro:unless value="$(arg opponent)">
  <gazebo reference="lidar">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>800</samples>
            <resolution>1.000000</resolution>
            <min_angle>-3.140000</min_angle>
            <max_angle>3.140000</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.015000</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
        <visibility_mask>0x01</visibility_mask>
      </lidar>
    </sensor>
  </gazebo>
  </xacro:unless>

  <!-- D435-like depth camera at 60 Hz, only with camera:=true. Depth alone:
       the detector stand-in reads truth, so nothing needs colour.
       sim.launch.py bridges it and depth_camera_emulator turns it into the
       D435's 16UC1 millimetres. -->
  <xacro:if value="$(arg camera)">
    <gazebo reference="camera">
      <sensor name="camera" type="depth_camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>60</update_rate>
        <topic>camera/depth_image</topic>
        <gz_frame_id>camera</gz_frame_id>
        <camera>
          <camera_info_topic>camera/camera_info</camera_info_topic>
          <horizontal_fov>1.5184</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <gazebo>
    <!-- /sim/raw_odom at 100 Hz, the Type-C board's /pose rate. It is the
         gz world pose, and the gz world is the field map's frame, so it is
         stamped map: rviz draws it through map->odom otherwise (T16). -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>root</robot_base_frame>
      <publish_odom_tf>true</publish_odom_tf>
      <tf_topic>/model/${name}/odom_tf</tf_topic>
      <dimensions>3</dimensions>
      <odom_publish_frequency>100</odom_publish_frequency>
    </plugin>
    <!-- The model's world pose and every link's pose in it, one stamped
         Pose_V on /model/<name>/pose at 250 Hz: the match test's truth for
         the camera and the panels (fixed-joint links like armor_i and
         camera are lumped into their parents in gz). -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>true</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>250</update_frequency>
    </plugin>
    <!-- Every joint, so robot_state_publisher can place the wheels too. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
    <!-- Head yaw and pitch track /head_pan_cmd and /head_pitch_cmd (rad).
         d_gain is sized for the real gimbal: about 0.031 kg m^2 about the
         yaw axis and 0.009 about pitch, near critical damping at p 75. -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>headlink</joint_name>
      <topic>/model/${name}/joint/headlink/cmd_pos</topic>
      <p_gain>75</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>2.1</d_gain>
      <i_max>0</i_max>
      <i_min>0</i_min>
      <cmd_max>50</cmd_max>
      <cmd_min>-50</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>headpitch</joint_name>
      <topic>/model/${name}/joint/headpitch/cmd_pos</topic>
      <p_gain>75</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>1.2</d_gain>
      <i_max>0</i_max>
      <i_min>0</i_min>
      <cmd_max>50</cmd_max>
      <cmd_min>-50</cmd_min>
    </plugin>
    <!-- Sets the chassis's full twist every step from /cmd_vel: planar
         velocity as commanded, zero angular velocity (a hard yaw lock), and
         zero vertical velocity, so the chassis settles onto its springs at
         about 1 cm/s but can't bounce. -->
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/${name}/cmd_vel</topic>
    </plugin>
  </gazebo>

  <xacro:if value="$(arg opponent)">
    <!-- No gravity and no contacts: an opponent only has to render (panels
         hide behind the field and other robots in the depth image) and be
         where its pose says; shots are scored geometrically. -->
    <xacro:macro name="ghost" params="link">
      <gazebo reference="${link}">
        <gravity>false</gravity>
        <collision>
          <surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface>
        </collision>
      </gazebo>
    </xacro:macro>
    <xacro:ghost link="spin_base"/>
    <xacro:ghost link="root"/>
    <xacro:ghost link="head"/>
    <xacro:ghost link="head_pitch"/>
    <xacro:ghost link="carrier_0"/>
    <xacro:ghost link="carrier_1"/>
    <xacro:ghost link="carrier_2"/>
    <xacro:ghost link="carrier_3"/>
    <xacro:ghost link="wheel_0"/>
    <xacro:ghost link="wheel_1"/>
    <xacro:ghost link="wheel_2"/>
    <xacro:ghost link="wheel_3"/>
    <link name="spin_base">
      <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    </link>
    <joint name="chassis_spin" type="continuous">
      <parent link="spin_base"/>
      <child link="root"/>
      <axis xyz="0 0 1"/>
    </joint>
    <gazebo>
      <!-- Sets chassis_spin's velocity (rad/s) straight from the topic. -->
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>chassis_spin</joint_name>
        <topic>/model/${name}/joint/chassis_spin/cmd_vel</topic>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
