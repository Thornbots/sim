  <!-- root is a genuinely free 6DOF body again, with no collision anywhere
       on the model (see body/head/odowheel above), and no parent joint at
       all, it's the URDF's implicit base link.
       This is a deliberate reversal of an earlier design that constrained
       root through a world->px->root chain of translation-only prismatic
       joints specifically to make rotation structurally impossible (real
       chassis is holonomic and never turns) and prevent wall-contact
       torque from flipping it. That design blocked true teleporting: gz's
       physics only honors a direct world-pose write (the "set_pose"
       service sim/auto_explore.py needs for its grid sweep) on a link
       gz-physics' FreeGroup API recognizes as free-floating, and a link
       with a parent joint doesn't qualify, confirmed empirically,
       set_pose calls against the old jointed root silently no-op'd.
       Free + collision-free removes both problems at once: nothing (no
       contact) can ever apply the torque the old design was defending
       against, so root can't actually flip even though rotation is
       physically possible again, and gz now treats it as a normal
       free body that set_pose actually moves.
       Since root is the base link again (as it was before the joint-chain
       design), robot_state_publisher has nothing to publish world->root
       from on its own, sentry_pkg/launch/auto.launch.py's default
       (publish_odom_tf:=true, odom_frame:=odom) is what supplies that via
       odom_to_tf, same as real hardware; no override needed.
       Rotational inertia (ixx/iyy/izz) is inflated ~1000x past body's
       real value as a soft rotation lock: even with the active headlink
       PID removed and auto_explore.py's model_only joint reset before
       every set_pose (see that file), occasional small chassis rotation
       was still observed after a teleport, root's own angular velocity
       isn't part of any joint's state (root has no parent joint), so
       nothing resets it if a teleport's hard position discontinuity
       momentarily induces a reaction impulse through headlink/odowheel_x/
       odowheel_y (all still attached to body, hence root, via real
       joints). This is the same soft-lock idea an earlier design used
       before it was replaced with a hard kinematic joint lock (see
       above), but that lock was defeated by repeated *contact* torque
       accumulation, which can't happen any more since this model has no
       collision anywhere; the only remaining torque source is an
       occasional single-step reaction impulse, and a large rotational
       inertia suppresses the angular velocity that impulse produces
       (impulse / inertia) to something negligible without needing any
       active force control. -->
  <link name="root">
    <inertial>
      <mass value="0.0507536"/>
      <origin xyz="-2.33205e-05 -3.02404e-05 0.160359" rpy="0 -0 0"/>
      <inertia ixx="2.26416" ixy="0" ixz="0" iyy="2.26416" iyz="0" izz="2.26416"/>
    </inertial>
  </link>
  <joint name="fastened_2" type="fixed">
    <origin xyz="0 0 0" rpy="0 -0 3.14159"/>
    <axis xyz="-0 -0 -1"/>
    <parent link="root"/>
    <child link="body"/>
  </joint>
  <joint name="headlink" type="revolute">
    <origin xyz="-2.54975e-18 5.65558e-17 0.252215" rpy="0 -0 3.14159"/>
    <axis xyz="0 0 -1"/>
    <parent link="body"/>
    <child link="head"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="3"/>
  </joint>
  <joint name="lidarlink" type="fixed">
    <origin xyz="-0.170562 -0.139254 0.0718" rpy="0 0 -1.95964"/>
    <parent link="head"/>
    <child link="lidar"/>
  </joint>
  <!-- Pitch axis for the head-mounted camera. Centered laterally (y=0) at
       the same height as the lidar's mount z (raised ~5cm to clear it),
       moved forward (+x) from head center so it sits out past the head's
       front face rather than buried inside it. -->
  <joint name="headpitch" type="revolute">
    <origin xyz="0.08 0 0.1218" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <parent link="head"/>
    <child link="head_pitch"/>
    <limit lower="-0.6" upper="0.6" effort="5" velocity="3"/>
  </joint>
  <joint name="cameralink" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="head_pitch"/>
    <child link="camera"/>
  </joint>
  <joint name="odowheel_x" type="continuous">
    <origin xyz="-0.089012 -0.009 0.0286405" rpy="3.14159 -0 3.14159"/>
    <axis xyz="0 -1 0"/>
    <parent link="body"/>
    <child link="odowheel"/>
  </joint>
  <joint name="odowheel_y" type="continuous">
    <origin xyz="0.014 -0.089012 0.0286405" rpy="0 0 -1.5708"/>
    <axis xyz="0 -1 0"/>
    <parent link="body"/>
    <child link="odowheel_1"/>
  </joint>
  <!-- Gravity is off on every link: root is genuinely free-floating now
       (see the link definition above) with no collision to rest on
       anything, so gravity would otherwise just make it fall forever. -->
  <gazebo reference="root">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="body">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="head">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="head_pitch">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="camera">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="odowheel">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="odowheel_1">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="lidar">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>3000</samples>
            <resolution>1.000000</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.280000</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- Matches RPLIDAR A2M8 datasheet: 0.15-12m -->
          <min>0.2</min>
          <max>12.0</max>
          <resolution>0.015000</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.03</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <!-- RealSense D435-like RGBD camera for CV testing (yolov8/nitros bridge
       etc). rgbd_camera bundles color + depth + camera_info under one
       sensor; <topic> is the prefix each is auto-published under (see
       sim/launch/sim.launch.py's camera bridges for the full subtopic
       names and how they're remapped to match realsense-ros' own topic
       names, so nodes written against real hardware work unmodified here).
       60Hz matches real hardware's profile (see
       realsense-yolov8-nitros-bridge/config/realsense_640x480x60.yaml). -->
  <gazebo reference="camera">
    <sensor name="camera" type="rgbd_camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>60</update_rate>
      <topic>camera</topic>
      <gz_frame_id>camera</gz_frame_id>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>root</robot_base_frame>
      <publish_odom_tf>true</publish_odom_tf>
      <dimensions>3</dimensions>
      <!-- Real hardware's Type-C board publishes /pose at ~100Hz; match that
           here so /sim/raw_odom -> pose_emulator -> /pose runs at the same
           rate sim and real hardware both feed into pose_translator/SLAM at. -->
      <odom_publish_frequency>100</odom_publish_frequency>
      <ros>
        <argument>-p use_sim_time:=true</argument>
      </ros>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>headlink</joint_name>
      <joint_name>headpitch</joint_name>
      <joint_name>odowheel_x</joint_name>
      <joint_name>odowheel_y</joint_name>
      <ros>
        <argument>-p use_sim_time:=true</argument>
      </ros>
    </plugin>
    <!-- Lets the gz sim GUI's "Joint Position Controller" panel (and
         sim/head_sweep.py, bridged into ROS) drive the head turn: publish a
         target angle (rad) on /model/sentry/joint/headlink/cmd_pos and this
         PID controller tracks it.
         Reintroduced after being removed for a while: this plugin holds
         its target via continuous PID torque, and since body/root are
         rigidly fastened with root a genuinely free 6DOF link (no parent
         joint, see the root link definition above), that reaction torque
         used to have nowhere to go but into rotating the whole free
         root/body assembly, which compounded into visible chassis
         rotation drift over an auto_explore.py sweep and corrupted the
         map. Safe to bring back now that both of that bug's actual fixes
         are in place: root's rotational inertia is inflated ~1000x (see
         the root link definition above), so any reaction torque this PID
         still produces yields negligible angular velocity, and
         auto_explore.py's teleport() now resets all joint state
         (including headlink) via a model_only WorldReset both before AND
         after every set_pose, so even a transient PID reaction from a
         teleport's position discontinuity gets wiped before the next hop
         either way.
         <topic> is set explicitly here (the plugin's own auto-generated
         default is .../headlink/0/cmd_pos) because that "/0/" index segment
         isn't valid as a ROS name token; ros_gz_bridge's remap rule
         parser rejects it outright ("Couldn't parse remap rule"), so
         bridging the default topic into ROS for head_sweep.py is
         impossible without overriding it here first. Hardcodes "sentry"
         since gz's topic templating doesn't reach into plugin params. -->
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>headlink</joint_name>
      <topic>/model/sentry/joint/headlink/cmd_pos</topic>
      <p_gain>2.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.05</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>
    <!-- Same idea as headlink's controller above: publish a target angle
         (rad, within headpitch's +/-0.6 limit) on
         /model/sentry/joint/headpitch/cmd_pos and this PID tracks it, so
         the camera can be tilted from the gz GUI or a bridged ROS topic. -->
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>headpitch</joint_name>
      <topic>/model/sentry/joint/headpitch/cmd_pos</topic>
      <p_gain>2.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.05</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>
    <!-- Lets the chassis actually be driven around in sim manually (e.g.
         sim/wasd_teleop.py). Real hardware moves via the DJI Type-C board
         directly, not ROS, so this only exists for sim; there's no
         equivalent on the real robot.
         root is a genuinely free link again (see the link definition
         above), so unlike the old prismatic-joint-chain design, a single
         VelocityControl plugin can take a Twist directly instead of
         needing sim/cmd_vel_to_joints.py to split it across two
         per-joint JointControllers. angular.z still isn't zeroed out
         here structurally the way the removed joint chain enforced it
         (root can physically rotate again, see the link definition
         above), so it's on wasd_teleop.py/whatever publishes /cmd_vel to
         not command it, matching the real robot's holonomic,
         never-turns behavior by convention rather than by construction. -->
    <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl">
      <topic>/model/sentry/cmd_vel</topic>
    </plugin>
  </gazebo>
</robot>
