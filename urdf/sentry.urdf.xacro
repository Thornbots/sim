<?xml version="1.0"?>
<!--URDF generated by ONSHAPE BY PTC INC, 1.217-->
<robot name="sentry_pkg">
  <!-- "world" is anchor for the planar_x/planar_y/root joint chain below.
       gz-sim recognizes "world" as the static world frame by name even
       without this declaration, but strict URDF parsers (e.g. the one
       robot_state_publisher uses) require every joint's parent link to
       actually be declared, so it's declared explicitly here too. -->
  <link name="world"/>
  <link name="body">
    <inertial>
      <mass value="0.0507536"/>
      <origin xyz="-2.33205e-05 -3.02404e-05 0.160359" rpy="0 -0 0"/>
      <inertia ixx="0.00127958" ixy="3.57925e-11" ixz="-1.40827e-07" iyy="0.00127958" iyz="-1.82614e-07" izz="0.00226416"/>
    </inertial>
    <visual>
      <origin xyz="0 -1.82166e-17 0.0734155" rpy="0 -0 0"/>
      <geometry>
        <mesh filename="package://sim/meshes/Body.stl" scale="1 1 1"/>
      </geometry>
      <material name="0.615686_0.811765_0.929412_0.000000_0.000000">
        <color rgba="0.615686 0.811765 0.929412 1"/>
      </material>
    </visual>
    <collision>
      <!-- Body.stl's actual footprint is ~0.595m x 0.595m x 0.252m tall
           (measured from the mesh); the previous collision cylinder here
           was radius 0.03 (3cm), ~10x too small, basically a single
           point contact instead of the real base. That gave the sim
           robot almost no resistance to tipping under any lateral push
           (e.g. from cmd_vel). Sized/centered to match the real mesh. -->
      <origin xyz="0 0 0.1262" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.28" length="0.252"/>
      </geometry>
    </collision>
  </link>
  <link name="head">
    <inertial>
      <mass value="0.00414744"/>
      <origin xyz="-0.00211769 -0.00164536 0.0741316" rpy="0 -0 1.18195"/>
      <inertia ixx="2.08028e-05" ixy="-3.50322e-06" ixz="-4.24357e-08" iyy="1.60288e-05" iyz="-3.29709e-08" izz="2.21034e-05"/>
    </inertial>
    <visual>
      <origin xyz="-2.54975e-18 1.04465e-18 0" rpy="0 -0 1.18195"/>
      <geometry>
        <mesh filename="package://sim/meshes/Head.stl" scale="1 1 1"/>
      </geometry>
      <material name="0.615686_0.811765_0.929412_0.000000_0.000000">
        <color rgba="0.615686 0.811765 0.929412 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.00211769 -0.00164536 0.0741316" rpy="0 -0 1.18195"/>
      <geometry>
        <box size="0.2 0.14 0.16075"/>
      </geometry>
    </collision>
  </link>
  <link name="lidar">
    <inertial>
      <mass value="0.00018588"/>
      <origin xyz="2.43997e-19 -6.96211e-19 0.02065" rpy="0 -0 1.90788"/>
      <inertia ixx="9.29949e-08" ixy="0" ixz="0" iyy="9.29949e-08" iyz="0" izz="1.33148e-07"/>
    </inertial>
    <visual>
      <origin xyz="2.18721e-18 7.6654e-19 0" rpy="0 -0 1.90788"/>
      <geometry>
        <mesh filename="package://sim/meshes/Lidar.stl" scale="1 1 1"/>
      </geometry>
      <material name="0.615686_0.811765_0.929412_0.000000_0.000000">
        <color rgba="0.615686 0.811765 0.929412 1"/>
      </material>
    </visual>
  </link>
  <link name="odowheel">
    <inertial>
      <mass value="3.2572e-05"/>
      <origin xyz="0 0.009 4.67781e-19" rpy="0 -0 0"/>
      <inertia ixx="5.56982e-09" ixy="0" ixz="0" iyy="9.38075e-09" iyz="0" izz="5.56982e-09"/>
    </inertial>
    <visual>
      <origin xyz="0 0.009 -1.46958e-18" rpy="0 -0 0"/>
      <geometry>
        <mesh filename="package://sim/meshes/OdoWheel.stl" scale="1 1 1"/>
      </geometry>
      <material name="0.615686_0.811765_0.929412_0.000000_0.000000">
        <color rgba="0.615686 0.811765 0.929412 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.018"/>
      </geometry>
    </collision>
  </link>
  <link name="odowheel_1">
    <inertial>
      <mass value="3.2572e-05"/>
      <origin xyz="0 0.009 4.67781e-19" rpy="0 -0 0"/>
      <inertia ixx="5.56982e-09" ixy="0" ixz="0" iyy="9.38075e-09" iyz="0" izz="5.56982e-09"/>
    </inertial>
    <visual>
      <origin xyz="0 0.009 -1.46958e-18" rpy="0 -0 0"/>
      <geometry>
        <mesh filename="package://sim/meshes/OdoWheel.stl" scale="1 1 1"/>
      </geometry>
      <material name="0.615686_0.811765_0.929412_0.000000_0.000000">
        <color rgba="0.615686 0.811765 0.929412 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.018"/>
      </geometry>
    </collision>
  </link>
  <!-- Constrains the whole chassis to X/Y translation + yaw only, no roll
       or pitch, by connecting it to the world through two prismatic joints
       and one revolute (yaw) joint instead of leaving it a free 6DOF body.
       Movement is already purely commanded (VelocityControl), not derived
       from real wheel/ground physics, so this loses nothing functionally
       and makes tipping over on a lip or ramp kinematically impossible
       (the previous fixes, wider body collision and disabled gravity,
       reduced how often it tipped but couldn't eliminate it; a ramp's
       inclined surface can still impart roll/pitch torque on a free body
       no matter how wide its footprint is). Mirrors what the real robot's
       suspension does: isolates the chassis from ground-level disturbances. -->
  <link name="planar_x">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="world_to_planar_x" type="prismatic">
    <parent link="world"/>
    <child link="planar_x"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1000" upper="1000" effort="1000" velocity="10"/>
  </joint>
  <link name="planar_y">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="planar_x_to_y" type="prismatic">
    <parent link="planar_x"/>
    <child link="planar_y"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1000" upper="1000" effort="1000" velocity="10"/>
  </joint>
  <link name="yaw_base">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="planar_y_to_root_yaw" type="continuous">
    <parent link="planar_y"/>
    <child link="yaw_base"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" velocity="10"/>
  </joint>
  <!-- Suspension: X/Y/yaw above are driven (JointController), always
       exactly what's commanded; a real vehicle's wheel-contact-patch
       motion is like that too. Everything below here is passive/gravity-
       driven, modeling the suspension that sits between the wheelbase and
       the chassis: heave (Z) lets the chassis ride up over a ramp or lip
       instead of being pinned to a fixed height; roll/pitch let it tilt to
       match the ground's local slope. Their <limit> ranges (+-25deg, +-0.3m)
       are the actual fix for the original flip-on-a-lip problem: even a
       hard impact can only rotate the chassis 25deg before the joint limit
       stops it, so a full flip (which needs ~90deg+) is structurally
       impossible, while a ramp's much shallower incline is well within
       range. <dynamics damping> keeps a sudden bump from making it
       oscillate instead of settling.
       (Earlier attempt eliminated Z/roll/pitch entirely; solved flipping
       but also made ramps impassable, since the chassis had no way to
       rise to a ramp's height at all. This is the corrected version.) -->
  <link name="susp_z">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="suspension_z" type="prismatic">
    <parent link="yaw_base"/>
    <child link="susp_z"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.3" upper="0.3" effort="1000" velocity="5"/>
    <dynamics damping="5.0"/>
  </joint>
  <link name="susp_roll">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="suspension_roll" type="revolute">
    <parent link="susp_z"/>
    <child link="susp_roll"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.44" upper="0.44" effort="1000" velocity="5"/>
    <dynamics damping="2.0"/>
  </joint>
  <link name="root"/>
  <joint name="suspension_pitch" type="revolute">
    <parent link="susp_roll"/>
    <child link="root"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.44" upper="0.44" effort="1000" velocity="5"/>
    <dynamics damping="2.0"/>
  </joint>
  <joint name="fastened_2" type="fixed">
    <origin xyz="0 0 0" rpy="0 -0 3.14159"/>
    <axis xyz="-0 -0 -1"/>
    <parent link="root"/>
    <child link="body"/>
  </joint>
  <joint name="headlink" type="revolute">
    <origin xyz="-2.54975e-18 5.65558e-17 0.252215" rpy="0 -0 3.14159"/>
    <axis xyz="0 0 -1"/>
    <parent link="body"/>
    <child link="head"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="3"/>
  </joint>
  <joint name="lidarlink" type="fixed">
    <origin xyz="-0.170562 -0.139254 0.0718" rpy="0 0 -1.95964"/>
    <parent link="head"/>
    <child link="lidar"/>
  </joint>
  <joint name="odowheel_x" type="continuous">
    <origin xyz="-0.089012 -0.009 0.0286405" rpy="3.14159 -0 3.14159"/>
    <axis xyz="0 -1 0"/>
    <parent link="body"/>
    <child link="odowheel"/>
  </joint>
  <joint name="odowheel_y" type="continuous">
    <origin xyz="0.014 -0.089012 0.0286405" rpy="0 0 -1.5708"/>
    <axis xyz="0 -1 0"/>
    <parent link="body"/>
    <child link="odowheel_1"/>
  </joint>
  <!-- Gravity is left ON here (unlike an earlier attempt that disabled it):
       the suspension_z/roll/pitch joints above need gravity + normal
       contact force to naturally settle the chassis onto the floor/ramp at
       the correct height and angle, the same way a real suspended vehicle
       does. Disabling gravity made the robot immune to floor lips but also
       unable to climb ramps at all, since a chassis with no weight has
       nothing pressing it down to follow the ground's shape. -->
  <gazebo reference="lidar">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.000000</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.280000</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- Matches RPLIDAR A2M8 datasheet: 0.15-12m -->
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.015000</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.03</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>root</robot_base_frame>
      <publish_odom_tf>true</publish_odom_tf>
      <dimensions>3</dimensions>
      <ros>
        <argument>-p use_sim_time:=true</argument>
      </ros>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>headlink</joint_name>
      <joint_name>odowheel_x</joint_name>
      <joint_name>odowheel_y</joint_name>
      <!-- OdometryPublisher's /odom orientation reads identity regardless
           of root's actual yaw now that root is joint-constrained (verified:
           the physics engine's own ground truth for root's link pose DOES
           show correct rotation, but OdometryPublisher's ROS-facing output
           doesn't reflect it; some assumption of the plugin's about a
           freely-floating base no longer holds). This joint's own position
           IS the robot's yaw by construction, so it's tracked here and
           sentry_pkg's odom_to_tf node uses it directly instead of trusting
           /odom's orientation field. -->
      <joint_name>planar_y_to_root_yaw</joint_name>
      <!-- Same story, but for Y position instead of yaw: confirmed via
           /world/.../pose/info and /world/.../state that root's Y position
           genuinely does update in the physics engine when
           planar_x_to_y is driven, but /odom's Y field stays 0 regardless.
           X position, oddly, reports correctly through /odom (only Y and
           yaw are affected); tracked here as a further workaround so
           odom_to_tf can source Y from here too instead of /odom. -->
      <joint_name>planar_x_to_y</joint_name>
      <ros>
        <argument>-p use_sim_time:=true</argument>
      </ros>
    </plugin>
    <!-- Lets the gz sim GUI's "Joint Position Controller" panel drive the
         head turn with a slider: that panel publishes a target angle (rad)
         on /model/sentry/joint/headlink/0/cmd_pos, which this PID controller
         tracks. Without this plugin the slider panel has nothing to command. -->
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>headlink</joint_name>
      <p_gain>2.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.05</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>
    <!-- Lets the chassis actually be driven around in sim (e.g. to sweep
         the room for mapping). Real hardware moves via the DJI Type-C board
         directly, not ROS, so this only exists for sim; there's no
         equivalent on the real robot.
         VelocityControl (which set a free body's velocity directly) can't
         be used anymore now that root is joint-constrained rather than a
         free 6DOF body; confirmed empirically, it produced zero motion
         when targeted at "root" since root has no linear DOF of its own
         (only the yaw joint). Driving a joint-constrained base needs
         per-joint velocity control instead, one JointController per DOF;
         sim/sim/cmd_vel_to_joints.py splits a single /cmd_vel Twist into
         the 3 per-joint velocity topics these subscribe to. -->
    <!-- use_force_commands=false (direct kinematic velocity injection)
         silently fails to move planar_x_to_y specifically: confirmed
         empirically that world_to_planar_x (parent="world", fixed) and
         planar_y_to_root_yaw (parent="planar_y", not itself kinematically
         driven) both work fine in kinematic mode, but planar_x_to_y's
         parent (planar_x) is itself the output link of another
         kinematically-controlled joint, and gz-sim's kinematic velocity
         mode doesn't compose across that chaining. Switched all three to
         force/PID mode so motion propagates through normal physics
         integration instead. -->
    <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
      <joint_name>world_to_planar_x</joint_name>
      <use_force_commands>true</use_force_commands>
      <p_gain>50</p_gain>
      <i_gain>1</i_gain>
      <d_gain>0</d_gain>
      <i_max>10</i_max>
      <i_min>-10</i_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
      <joint_name>planar_x_to_y</joint_name>
      <use_force_commands>true</use_force_commands>
      <p_gain>50</p_gain>
      <i_gain>1</i_gain>
      <d_gain>0</d_gain>
      <i_max>10</i_max>
      <i_min>-10</i_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
      <joint_name>planar_y_to_root_yaw</joint_name>
      <use_force_commands>true</use_force_commands>
      <p_gain>50</p_gain>
      <i_gain>1</i_gain>
      <d_gain>0</d_gain>
      <i_max>10</i_max>
      <i_min>-10</i_min>
    </plugin>
  </gazebo>
</robot>
